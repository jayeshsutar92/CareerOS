# ==========================================
# Production-Ready .gitignore
# Python (FastAPI/uv) + Node.js (Next.js/pnpm)
# ==========================================

# ------------------------------------------
# Environment & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!.env*.example
!.env.template

# ------------------------------------------
# Python, FastAPI & uv
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
tests/

# Virtual environments & uv
.venv/
.venv*/
venv/
venv*/
ENV/
env/
.uv/

# Caches & Tooling (pytest, mypy, ruff, celery)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.cache/
celerybeat-schedule
celerybeat.pid

# Test coverage reports
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/

# ------------------------------------------
# Node.js, Next.js & pnpm
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
out/

# Turbo / Build Caches
.turbo/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel
.vercel/

# ------------------------------------------
# Docker & Containers
# ------------------------------------------
.docker/
*.dockerlog

# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak
*.tmp

# ------------------------------------------
# OS-Specific Files
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log

# ------------------------------------------
# Custom ignored files
# ------------------------------------------
use.txt
templates.txt
sample.txt
backend/test_lead_agent.py
final.txt
final1.txt