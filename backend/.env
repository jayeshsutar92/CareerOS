DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/careeros

REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=

AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024
AI_LOG_PROMPTS=false
AI_INPUT_TOKEN_COST_PER_1M=0
AI_OUTPUT_TOKEN_COST_PER_1M=0

JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_KEY_PREFIX=careeros
CACHE_DEFAULT_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

WORKER_QUEUE_NAME=default
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_SECONDS=30
WORKER_RESULT_TTL_SECONDS=86400
WORKER_SCHEDULED_POLL_INTERVAL_SECONDS=5
